# ---------------------------------------------------------------------------
# Next.js frontend .gitignore
# ---------------------------------------------------------------------------

# Dependencies
/node_modules
/.pnp
.pnp.js
.pnp.cjs
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js build output
/.next/
/out/
/build
/dist

# Testing / coverage
/coverage

# Environment files
# .env holds secret values (JWT secrets) -> never commit it.
# Non-sensitive per-environment files (.env.development / .env.production) stay tracked.
.env
.env.local
.env.*.local
!.env.example
!.env.development
!.env.production

# Logs & debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Caches & build info
*.tsbuildinfo
next-env.d.ts
.history

# Deployment
.vercel

# Certificates
*.pem

# Editor / IDE
/.idea
/.vscode
/.zed

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Third-party tooling
/.anima
